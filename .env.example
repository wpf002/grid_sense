# GridSense environment variables
# Copy to .env and fill in real values. Never commit .env.

# ---- Required ----

# Admin login password. Hashed with bcrypt on first boot.
GRIDSENSE_ADMIN_PASSWORD=change-me-to-a-long-random-string

# HMAC secret for session cookies. Generate with: openssl rand -hex 32
GRIDSENSE_SESSION_SECRET=change-me-to-a-64-char-hex-string

# ---- Optional ----

# Gate the entire app behind a shared password (useful for private beta).
# GRIDSENSE_SITE_PASSWORD=beta-access

# Dev only. Allows session cookie over http (localhost). Do NOT set in prod.
# GRIDSENSE_INSECURE_COOKIE=1

# SMTP for alert emails. All five must be set together, or leave all unset.
# GRIDSENSE_SMTP_HOST=smtp.example.com
# GRIDSENSE_SMTP_PORT=587
# GRIDSENSE_SMTP_USER=alerts@example.com
# GRIDSENSE_SMTP_PASS=your-smtp-password
# GRIDSENSE_SMTP_FROM=GridSense Alerts <alerts@example.com>

# Server port. Defaults to 5000.
# PORT=5000

# Node environment. Set to "production" for deploy.
NODE_ENV=development

# Google SSO (optional). Create an OAuth 2.0 Web client in Google Cloud Console.
# Redirect URI: http://localhost:5050/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback
